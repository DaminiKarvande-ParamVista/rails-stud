<%= form_with model: student do |form| %>
  <% if @student.errors.any? %>
    <% @student.errors.full_messages.each do |message| %>
      <p><%= message %></p>
      <% end %>
    <% end %>
    <div class= "form-group">
    <span class= 'text-danger'>*</span>
      <%= form.label :first_name %>
      <%= form.text_field :first_name, class: 'form-control form-control-lg' %>
      <p class= 'text-danger'>
      <%= @student.errors[:first_name].first%></p>
    </div>
    <div class= "form-group">
      <%= form.label :last_name %>
      <%= form.text_field :last_name, class: 'form-control form-control-lg' %> <br>
    </div>
    <div class= "form-group">
      <%= form.label :email_address %>
      <%= form.email_field :email_address, class: 'form-control form-control-lg' %> <br>
    </div>
    <div class= "form-group">
      <%= form.label :permanent_contact %>
      <%= form.telephone_field :permanent_contact, class: 'form-control form-control-lg' %> <br>
    </div>
    <div class= "form-group">
      <%= form.label :alternative_contact %>
      <%= form.telephone_field :alternative_contact, class: 'form-control form-control-lg' %> <br>
    <div class= "form-group">
    <%= form.label :date_of_birth %>
    <%= form.date_field :date_of_birth, class: 'form-control form-control-lg' %> <br>
    </div>
    <div class= "form-group">
    <%= form.label :local_address %>
    <%= form.text_field :local_address, class: 'form-control form-control-lg'  %> <br>
    </div>
    <div class= "form-group">
    <%= form.label :permanent_address %>
    <%= form.text_field :permanent_address, class: 'form-control form-control-lg'  %> <br>
    </div>
    <div class= "form-group">
      <%= form.submit class: 'btn btn-primary btn-lg'  %>
    </div>
<% end %>