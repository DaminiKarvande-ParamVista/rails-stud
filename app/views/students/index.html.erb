<div class= 'col-lg-12' height="100%">
<%= notice %>
<h1>Listing Students</h1>
<%= link_to 'New Student', new_student_path, class:"btn btn-primary" %>
<table class='table table-bordered'>
<thead>
<tr>
    <th>First Name</th>
    <th>Last Name</th>
    <th>Email Address</th>
    <th>Permanent Contact</th>
    <th>Alternative Contact</th>
    <th>Date of Birth</th>
    <th>Local Address</th>
    <th>Permanent Address</th>
    <th colspan="3">Actions</th>
</tr>
<% @students.each do |student|%>
    <tr>
    <td><%= student.first_name %></td>
    <td><%= student.last_name %></td>
    <td><%= student.email_address %></td>
    <td><%= student.permanent_contact %></td>
    <td><%= student.alternative_contact %></td>
    <td><%= student.date_of_birth %></td>
    <td><%= student.local_address %></td>
    <td><%= student.permanent_address %></td>
    <td><%= link_to 'View', student %></td>
    <td><%= link_to 'Edit', edit_student_path(student) %></td>
    <%# <td><%= link_to 'Delete', student, method: :delete, data: { confirm: 'Are you sure?' } %></td>
    <td><%= button_to 'Delete', student_path(student), method: :delete, data: { turbo_confirm: 'Are you sure?' } %></td> 
    <%# without method browser thinks it is a get method %>
    </tr>
<% end %>
</thead>
</table>
</div>