<h1>Hello Admin User </h1>

<p>
  A new entry for <%= @object.class.to_s %> has been created. Below are the details of object created:
</p>

<%= @object.attributes.each do |attr_key, attr_value| %>
  <p><strong><%= attr_key.humanize%></strong><%= attr_value %></p>
<% end %>

<h4>Now the <%= @object.class.to_s %> has total of <%= @object_count %> records. </h4>
<h4>Thanks.</h4>
<h4>Admin Teams</h4>
