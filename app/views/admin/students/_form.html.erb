<%= form_with model: [:admin, student] do |form| %>

  <%= render 'admin/shared/error', model: student %>

  <div class="form-group">
    <%= form.label :first_name %>
    <%= form.text_field :first_name, class: 'form-control form-control-lg' %>
  </div>

  <div class="form-group">
    <%= form.label :last_name %>
    <%= form.text_field :last_name, class: 'form-control form-control-lg' %>
  </div>

  <div class="form-group">
    <%= form.label :email_address %>
    <%= form.email_field :email_address, class: 'form-control form-control-lg' %>
  </div>

  <div class="form-group">
    <%= form.label :permanent_contact %>
    <%= form.telephone_field :permanent_contact, class: 'form-control form-control-lg' %>
  </div>

  <div class="form-group">
    <%= form.label :alternative_contact %>
    <%= form.telephone_field :alternative_contact, class: 'form-control form-control-lg' %>
  </div>

  <div class="form-group">
    <%= form.label :date_of_birth %>
    <%= form.date_field :date_of_birth, class: 'form-control form-control-lg' %>
  </div>

  <div class="form-group">
    <%= form.label :local_address %>
    <%= form.text_field :local_address, class: 'form-control form-control-lg' %>
  </div>

  <div class="form-group">
    <%= form.label :permanent_address %>
    <%= form.text_field :permanent_address, class: 'form-control form-control-lg' %>
  </div>

  <!-- ✅ ActionText (NO extra form) -->
  <div class="form-group">
    <%= form.label :description %>
    <%= form.rich_text_area :description %>
  </div>

  <div class="form-group">
    <%= form.label :profile_image %>
    <%= form.file_field :profile_image %>
  </div>

  <div class="form-group">
    <%= form.submit class: 'btn btn-primary btn-lg' %>
  </div>

<% end %>