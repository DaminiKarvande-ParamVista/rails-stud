<div class='col-lg-12' data-controller="user-name">

  <div class="form-group mb-3">
    <input 
      type="text"
      placeholder="<%= t('students.search') %>"
      class="form-control"
      data-user-name-target="search"
      data-action="keyup->user-name#filter"
    >
  </div>

  <%= search_form_for @q, url: :admin_students do |form| %>
    <div class="form-group">
      <%= form.label :first_name, t("students.first_name") %>
      <%= form.text_field :first_name_cont, class: "form-control" %>

      <%= form.label :last_name, t("students.last_name") %>
      <%= form.text_field :last_name_eq, class: "form-control" %>
    </div>

    <div class="form-group mt-2">
      <%= form.submit t("buttons.search"), class: 'btn btn-primary btn-lg' %>
    </div>
  <% end %>

  <p><%= notice %></p>
  <h1><%= t("students.title") %></h1>

  <% if policy(Student).create? %>
    <%= link_to t("students.new"), new_admin_student_path, class: "btn btn-primary mb-3" %>
  <% end %>

  <table class='table table-bordered'>
    <thead>
      <tr>
        <th><%= t("students.first_name") %></th>
        <th><%= t("students.last_name") %></th>
        <th><%= t("students.email") %></th>
        <th><%= t("students.contact") %></th>
        <th><%= t("students.alt_contact") %></th>
        <th><%= t("students.dob") %></th>
        <th><%= t("students.local_address") %></th>
        <th><%= t("students.permanent_address") %></th>
        <th colspan="3"><%= t("students.actions") %></th>
      </tr>
    </thead>

    <tbody>
      <% @students.each do |student| %>
        <tr data-user-name-target="row">
          <td><%= student.first_name %></td>
          <td><%= student.last_name %></td>
          <td><%= student.email_address %></td>
          <td><%= student.permanent_contact %></td>
          <td><%= student.alternative_contact %></td>
          <td><%= student.date_of_birth %></td>
          <td><%= student.local_address %></td>
          <td><%= student.permanent_address %></td>

          <td><%= link_to t("students.view"), admin_student_path(student) %></td>

          <td>
            <% if policy(student).update? %>
              <%= link_to t("students.edit_link"), edit_admin_student_path(student) %>
            <% end %>
          </td>

          <td>
            <% if policy(student).destroy? %>
              <%= button_to t("students.delete"), admin_student_path(student),
                  method: :delete,
                  data: { turbo_confirm: t("students.confirm_delete") } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="d-flex justify-content-center">
    <%= paginate @students %>
  </div>

</div>