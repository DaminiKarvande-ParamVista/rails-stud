<div class="container">
  <div class="row justify-content-center">

    <div class="col-xl-10 col-lg-12 col-md-9">

      <div class="card o-hidden border-0 shadow-lg my-5">
        <div class="card-body p-0">

          <div class="row">

            <!-- Left Image -->
            <div class="col-lg-6 d-none d-lg-block bg-password-image">
              <%= image_tag "undraw_rocket.svg", class: "img-fluid h-100 w-100" %>
            </div>

            <!-- Right Form -->
            <div class="col-lg-6">
              <div class="p-5">

                <div class="text-center">
                  <h1 class="h4 text-gray-900 mb-2">Forgot Your Password?</h1>
                  <p class="mb-4">
                    Enter your email and we’ll send you reset instructions.
                  </p>
                </div>

                <%= form_for(resource,
                      as: resource_name,
                      url: password_path(resource_name),
                      html: { method: :post, class: "user" }) do |f| %>

                  <%= render "admin_users/shared/error_messages", resource: resource %>

                  <!-- Email -->
                  <div class="form-group">
                    <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          class: "form-control form-control-user",
                          placeholder: "Enter Email Address..." %>
                  </div>

                  <!-- Submit -->
                  <%= f.submit "Reset Password",
                        class: "btn btn-primary btn-user btn-block" %>

                <% end %>

                <hr>

                <div class="text-center">
                  <%= link_to "Create an Account!",
                        new_registration_path(resource_name),
                        class: "small" %>
                </div>

                <div class="text-center">
                  <%= link_to "Already have an account? Login!",
                        new_session_path(resource_name),
                        class: "small" %>
                </div>

              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</div>