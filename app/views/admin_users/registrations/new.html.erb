<div class="container">
  <div class="card o-hidden border-0 shadow-lg my-5">
    <div class="card-body p-0">
      <div class="row">

        <!-- Left Image -->
        <div class="col-lg-5 d-none d-lg-block bg-register-image">
          <%= image_tag "undraw_rocket.svg", class: "img-fluid h-100 w-100" %>
        </div>

        <!-- Right Form -->
        <div class="col-lg-7">
          <div class="p-5">

            <div class="text-center">
              <h1 class="h4 text-gray-900 mb-4">Create an Account!</h1>
            </div>

            <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "user" }) do |f| %>

              <%= render "admin_users/shared/error_messages", resource: resource %>

              <!-- Email -->
              <div class="form-group">
                <%= f.email_field :email, autofocus: true, autocomplete: "email",
                  class: "form-control form-control-user",
                  placeholder: "Enter Email Address..." %>
              </div>

              <!-- Password -->
              <div class="form-group row">
                <div class="col-sm-6 mb-3 mb-sm-0">
                  <%= f.password_field :password, autocomplete: "new-password",
                    class: "form-control form-control-user",
                    placeholder: "Password" %>

                  <% if @minimum_password_length %>
                    <small class="text-muted">
                      (<%= @minimum_password_length %> characters minimum)
                    </small>
                  <% end %>
                </div>

                <div class="col-sm-6">
                  <%= f.password_field :password_confirmation, autocomplete: "new-password",
                    class: "form-control form-control-user",
                    placeholder: "Repeat Password" %>
                </div>
              </div>

              <!-- Submit -->
              <%= f.submit "Register Account",
                    class: "btn btn-primary btn-user btn-block" %>

            <% end %>

            <hr>

            <div class="text-center">
              <%= link_to "Forgot Password?", new_password_path(resource_name), class: "small" %>
            </div>

            <div class="text-center">
              <%= link_to "Already have an account? Login!",
                    new_session_path(resource_name),
                    class: "small" %>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</div>